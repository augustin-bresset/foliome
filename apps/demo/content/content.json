      "sections": [
        {
          "id": "i_seed010",
          "type": "texte",
          "text": {
            "$t": {
              "fr": [
                [
                  {
                    "text": "La halle était fermée depuis vingt ans. Le projet retire tout ce qui avait été ajouté, puis glisse sous la charpente deux volumes bas en bois qui ne la touchent nulle part."
                  }
                ],
                [
                  {
                    "text": "Le sol en béton désactivé se prolonge sur le parvis : les jours de marché, les étals débordent dehors."
                  }
                ]
              ],
              "en": [
                [
                  {
                    "text": "The hall had been closed for twenty years. The project removes everything that had been added, then slides two low timber volumes under the roof frame without touching it anywhere."
                  }
                ],
                [
                  {
                    "text": "The exposed-aggregate concrete floor runs out onto the forecourt: on market days, the stalls spill outside."
                  }
                ]
              ]
            }
          }
        },
