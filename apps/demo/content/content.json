      "surface": "148 m²",
      "summary": {
        "$t": {
          "fr": "Trois demi-niveaux posés sur un terrain à 38 %, pour ne rien terrasser.",
          "en": "Three half-levels set on a 38% slope, so that nothing is levelled."
        }
      },
