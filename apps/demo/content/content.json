      "sections": [
        {
          "id": "i_seed004",
          "type": "texte",
          "text": {
            "$t": {
              "fr": [
                [
                  {
                    "text": "Le bâtiment tourne le dos au couloir d’avalanche et s’ouvre au sud-est, vers le lever du jour. Sa structure en épicéa lamellé a été préfabriquée dans la vallée, par modules dimensionnés pour l’hélicoptère."
                  }
                ],
                [
                  {
                    "text": "Le socle en pierre du site abrite le local hors-sac, "
                  },
                  {
                    "text": "accessible tout l’hiver sans gardien",
                    "italic": true
                  },
                  {
                    "text": ". Le chantier est raconté dans le "
                  },
                  {
                    "text": "carnet de l’atelier",
                    "href": "/#atelier"
                  },
                  {
                    "text": "."
                  }
                ]
              ],
              "en": [
                [
                  {
                    "text": "The building turns its back on the avalanche path and opens to the south-east, towards sunrise. Its laminated spruce frame was prefabricated in the valley, in modules sized for the helicopter."
                  }
                ],
                [
                  {
                    "text": "The plinth, built with stone from the site, houses the winter room, "
                  },
                  {
                    "text": "open all winter with no warden",
                    "italic": true
                  },
                  {
                    "text": ". The building site is told in the "
                  },
                  {
                    "text": "studio’s notebook",
                    "href": "/en#atelier"
                  },
                  {
                    "text": "."
                  }
                ]
              ]
            }
          }
        },
