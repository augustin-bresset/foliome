{
  "name": "@foliome/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./dist/editor.js": "./dist/editor.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=iife --target=es2022 --minify --jsx=automatic --jsx-import-source=preact --loader:.css=text --outfile=dist/editor.js",
    "dev": "npm run build -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@foliome/core": "*",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
